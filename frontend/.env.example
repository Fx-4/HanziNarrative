# API Configuration
VITE_API_URL=http://localhost:8000

# For production, set this to your deployed backend URL:
# VITE_API_URL=https://your-backend.onrender.com

# Pre-generated course TTS (Supabase Storage public bucket). Optional — leave
# empty to disable. Set ONLY after running backend/scripts/generate_tts_static.py,
# so the client serves fixed course audio straight from the CDN (no cold start).
# VITE_TTS_STATIC_URL=https://<ref>.supabase.co/storage/v1/object/public/tts-audio
