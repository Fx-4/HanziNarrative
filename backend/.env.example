# Database Configuration
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Security
SECRET_KEY=your-secret-key-here-generate-a-strong-one
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=30

# API Keys
GEMINI_API_KEY=your-gemini-api-key-here

# Giphy (optional) — meme motivasi/break di completion screen kursus
# Daftar gratis di https://developers.giphy.com/ ; kosongkan untuk menonaktifkan
GIPHY_API_KEY=

# CORS Origins (comma-separated for multiple origins)
CORS_ORIGINS=https://hanzi-narrative.vercel.app
ALLOWED_REDIRECT_ORIGINS=https://hanzi-narrative.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# Environment
ENVIRONMENT=production
